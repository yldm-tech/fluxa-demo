# fluxa payment integration demo — copy this to .env and fill in your keys.
# All languages in this repo read this one file.
#
#   cp .env.example .env
#
# Where the keys come from:
#   1. Sign in to the merchant portal:  https://pay.fluxa.cash/portal
#   2. Developers → API Keys → New Key
#   3. Pick "Test" mode to start — test orders move no real money but still fire webhooks,
#      so you can exercise the whole integration safely.
#   4. The secret is shown ONCE. Save it now; it is stored encrypted and cannot be retrieved.

# fluxa API base URL. Hosted service:
FLUXA_BASE_URL=https://pay.fluxa.cash

# Your merchant API key pair.
#   key_id  goes in the X-Api-Key header
#   secret  signs the request (HMAC-SHA256) and must never leave your server
FLUXA_KEY_ID=pk_test_replace_me
FLUXA_SECRET=sk_test_replace_me

# Webhook signing secret — verifies that callbacks really came from fluxa.
# This is a DIFFERENT secret from the API secret above.
# Portal → Developers → Webhooks.
FLUXA_WEBHOOK_SECRET=whsec_replace_me

# Payment channel.
#
# The channel's environment must match your key's mode, or you get
# 400 channel_environment_mismatch (that is NOT a signature problem):
#   Test key (pk_test_/sk_test_) → a test-environment channel, e.g. mock
#   Live key (pk_live_/sk_live_) → a live-environment channel, e.g. stripe
#
# Run the signed `GET /api/v1/channels` to list exactly what your account can use —
# every demo here can make that call. `mock` is the sandbox channel: its checkout page
# has a "simulate success" button, so you can drive the full flow end to end.
FLUXA_CHANNEL=mock

FLUXA_CURRENCY=USD
FLUXA_AMOUNT=9.99

# Local port for the webhook receiver demo. Only run one language's receiver at a time.
WEBHOOK_PORT=9000
